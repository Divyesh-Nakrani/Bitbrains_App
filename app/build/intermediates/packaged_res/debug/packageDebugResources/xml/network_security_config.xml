<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows plain-HTTP (cleartext) traffic ONLY to local development hosts, so the
    app can talk to the dummy backend during local testing. All other traffic
    (i.e. a real https:// production backend) still requires TLS.

    Hosts:
      10.0.2.2   - the host machine, as seen from the standard Android emulator
      10.0.3.2   - the host machine, as seen from a Genymotion emulator
      127.0.0.1  - loopback (e.g. when using `adb reverse tcp:5000 tcp:5000`)
      localhost
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
